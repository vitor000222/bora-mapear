# Copie para .env e preencha. O .env não vai para o Git.

# Chave-mestra que cifra as chaves de API dos provedores. Use um texto longo e aleatório
# e guarde: se mudar, as chaves cadastradas precisam ser cadastradas de novo.
BORA_SECRET=troque-por-um-texto-longo-e-aleatorio

# Opcional: Postgres. Sem isso, o banco é SQLite em data/bora.db.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/bora

# Só para o docker compose:
POSTGRES_PASSWORD=bora
# PORTA=3737
