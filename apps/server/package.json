{
  "name": "@bora-mapear/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor do Bora Mapear: API de mapeamentos, versões da matriz e visões, sobre SQLite.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
