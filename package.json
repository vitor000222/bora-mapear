{
  "name": "bora-mapear",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Mapeamento de processos com IA: uma matriz, várias linguagens (BPMN, Mermaid, React Flow).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build --workspace @bora-mapear/web",
    "start": "npm run start --workspace @bora-mapear/server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "exemplo": "node packages/core/src/cli.ts renderizar exemplos/pedido-de-venda.json --saida saida",
    "example": "node packages/core/src/cli.ts render exemplos/sales-order.json --output output",
    "schema": "node packages/core/src/cli.ts schema",
    "llm-falso": "node scripts/llm-falso.ts"
  }
}
